# NexBrief Environment Variables
# Copy to .env and fill in your own keys

PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexbrief?retryWrites=true&w=majority

# JWT Authentication Secret (32+ chars random string)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# NewsAPI.org Key (https://newsapi.org)
NEWS_API_KEY=your_newsapi_org_api_key

# Brevo Transactional HTTP API Key (Port 443 HTTPS delivery)
BREVO_API_KEY=your_brevo_xkeysib_api_key
FROM_EMAIL=newsletter@nexbrief.com
FROM_NAME=NexBrief Daily

# Optional: Google Gemini API Key (https://aistudio.google.com)
# Powers AI "Why This Matters" 1-line summaries (falls back to built-in rules if unset)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Web Push VAPID Keys (auto-generated & stored in MongoDB if left blank)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:newsletter@nexbrief.com

# Public Application URL (used in email links & open tracking pixel)
APP_URL=https://nexbrief-news.onrender.com
