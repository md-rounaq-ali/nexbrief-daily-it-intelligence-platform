# Environment Variables — NexBrief
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas — Get from cloud.mongodb.com (free M0 cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexbrief?retryWrites=true&w=majority

# JWT Secret — Use a LONG random string (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_to_something_random_and_long_32chars

# NewsAPI.org — Get free key from newsapi.org (100 req/day free)
NEWS_API_KEY=your_newsapi_org_api_key_here

# Brevo SMTP — Get from brevo.com → Settings → SMTP & API
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_account_email@example.com
BREVO_SMTP_PASS=your_brevo_smtp_password_key

# Email Sender Info
FROM_EMAIL=newsletter@nexbrief.com
FROM_NAME=NexBrief Daily

# NOTE: Admin access is HARDCODED to tabrasali7@gmail.com
# Register with this email to automatically get admin access.
# No need to set ADMIN_EMAIL here.

# App URL (used in email links)
# Local: http://localhost:3000
# Production: https://your-app.onrender.com
APP_URL=http://localhost:3000
