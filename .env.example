# Environment Variables — NexBrief
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas — Get from cloud.mongodb.com (free M0 cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nexbrief?retryWrites=true&w=majority

# JWT Secret — Use a LONG random string (min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_change_this_to_something_random_and_long_32chars

# NewsAPI.org — Get free key from newsapi.org (100 req/day free)
NEWS_API_KEY=your_newsapi_org_api_key_here

# Brevo Transactional API (Port 443 HTTPS — bypasses SMTP port blocks on cloud hosting)
BREVO_API_KEY=your_brevo_xkeysib_api_key_here
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_account_email@example.com
BREVO_SMTP_PASS=your_brevo_smtp_password_key

# Email Sender Info
FROM_EMAIL=newsletter@nexbrief.com
FROM_NAME=NexBrief Daily

# Optional: Google Gemini API Key (Free tier at aistudio.google.com)
# Enables AI-generated 1-line "Why This Matters" summaries per article.
# If omitted, NexBrief uses a built-in domain-aware insight generator automatically.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Web Push VAPID Keys (npx web-push generate-vapid-keys)
# If omitted, NexBrief automatically generates & persists keys in MongoDB.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:newsletter@nexbrief.com

# App URL (used in email links & open-tracking pixel)
# Local: http://localhost:3000
# Production: https://nexbrief-news.onrender.com
APP_URL=https://nexbrief-news.onrender.com
